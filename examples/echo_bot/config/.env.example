TELEGRAM_BOT_TOKEN=your_token_here

# Optional password required to use the bot. Users authorize themselves once by
# sending this password to the bot. If unset, the bot is open to anyone.
# BOT_PASSWORD=your_secret_password

# Proxy for bot's HTTPS traffic to api.telegram.org
# Uncomment if api.telegram.org is blocked in your network
# HTTP_PROXY=http://your-proxy-host:port
# HTTPS_PROXY=http://your-proxy-host:port
# HTTPS_PROXY=socks5://your-proxy-host:1080
# NO_PROXY=localhost,127.0.0.1,.local
